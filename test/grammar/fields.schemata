schema shop.events

// Field and option names that look like builtin types or options are still names.
model Event {
  #1 date   date
  #2 string string /* a label */
  #3 index  int32 { index }
  #4 active bool = true
  #5 offset int32 = -5
  #6 rate   float64 { min -1.5, max 1.5 } = 1.5
  #7 note   string? @deprecated("say \"hi\"")
  #8 kind   enum { a b c } = a
  #9 place  { lat float64  lon float64 }[] { minItems 1 }
  reserved #10..#12
}

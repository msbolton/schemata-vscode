/// Orders and their lines.
schema shop.orders

model OrderId { id uuid { id } }

// Outside a service, a verb or `errors` is an ordinary field name.
model Request { get string  post bool  errors string[] }

/// Place and read orders.
@http(base: "/v1")
service Orders {
  errors { 400 Problem  default Problem }
  /// Fetch one order.
  #1 get(OrderId): Order  get "/orders/{id}"  errors { 404 Problem }
  #2 list(ListOrders): stream Order  get "/orders" // newest first
  #3 place(PlaceOrder): Order  post "/orders" 201
  #4 cancel(OrderId)  delete "/orders/{id}" 204  errors {
    409 catalog.Conflict
    503
  }
  #5 upload(stream Chunk): Receipt
  #6 sync(catalog.Batch[]): Receipt?  put "/sync"
  reserved #7, "archive"
}

model After { delete bool }

/// Order management for the storefront.
schema shop.orders @sql(schema: "shop")

import shop.customers as cust

alias Email = string { max 254, match "^[^@]+@[^@]+$" }

alias Money = decimal(19, 4)

enum Status { pending paid, shipped cancelled }

model Card { last4 string { max 4 }  brand string { max 32 } }

model Cash {}

union Payment = Card | #2 string { max 34 } | Cash

/// A customer's order. One row per checkout.
model Order {
  #1  id        uuid     { id }
  #2  customer  cust.Customer @relation(onDelete: cascade)
  #3  status    Status   = pending
  #4  lines     Line[]   { minItems 1, maxItems 10 }
  #5  total     Money
  #6  shipping  Address  { embed }
  #7  note      string?  { max 500 }
  @deprecated("use placed_at")
  #8  created   instant?
  #9  holes     string?[]?
  #10 counts    map<string { max 20 }, int32?>
  reserved #11, "legacy_ref"

  /// One purchasable item.
  model Line { sku string { max 64 }  quantity int32 { min 1 }  price Money }

  model Address {
    street  string { max 200 }
    country string { min 2, max 2 }
  }

  @@index(customer, status)
  @@sql(unique: (customer, note))
}
